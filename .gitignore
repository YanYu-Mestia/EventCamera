# ==========================================
# 操作系统与通用编辑器垃圾文件
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.vcxproj
*.filters

# ==========================================
# C++ 过滤规则
# ==========================================
# 编译生成的二进制文件与可执行程序
*.exe
*.out
*.app
*.o
*.obj
*.dll
*.so
*.dylib

# 调试符号与临时日志
*.pdb
*.ilk
*.lk
*.log

# 常见的构建目录（如 CMake、Visual Studio 产生的文件夹）
build/
x64/
Debug/
Release/
.vs/
ipch/

# ==========================================
# Python 过滤规则
# ==========================================
# 字节码缓存（最常见的 Python 垃圾文件）
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境（绝对不要上传，太大了）
.venv/
venv/
ENV/
env/

# 环境变量与密钥文件（保护隐私）
.env
.env.secret